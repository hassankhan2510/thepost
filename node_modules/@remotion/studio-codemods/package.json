{
	"name": "@remotion/studio-codemods",
	"version": "4.0.514",
	"description": "Shared codemods for Remotion Studio",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"module": "dist/esm/index.mjs",
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/studio-codemods"
	},
	"type": "module",
	"scripts": {
		"test": "bun test src/test",
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"lint": "eslint src",
		"watch": "tsgo -w",
		"make": "tsgo && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"@babel/parser": "7.24.1",
		"@babel/types": "7.24.0",
		"@remotion/studio-shared": "4.0.514",
		"ast-types": "0.16.1",
		"recast": "0.23.11",
		"remotion": "4.0.514"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"@remotion/eslint-config-internal": "4.0.514",
		"@typescript/native-preview": "7.0.0-dev.20260217.1",
		"eslint": "9.19.0"
	},
	"keywords": [
		"remotion",
		"studio",
		"codemod"
	],
	"publishConfig": {
		"access": "public"
	}
}
